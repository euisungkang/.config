# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #0e0e0e
selected_bg = #1a1a1a
header_bg = #262626

# Text colors
text = #e5e5e5
selected_text = #c6c6c6
header_text = #ababab
inactive_text = #767676

# GPU utilization colors (gradient from low to high)
gpu_util_low = #d0e8b6
gpu_util_med = #f3f2e5
gpu_util_high = #c0b56b

# Memory usage colors
memory_low = #d0e6c5
memory_med = #abd1ac
memory_high = #95c9a8

# Temperature colors (cool to hot)
temp_cool = #d0e8b6
temp_warm = #f3f2e5
temp_hot = #c0b56b

# Power usage colors
power_low = #d0e8b6
power_med = #cfd0ab
power_high = #c5c09a

# Process list colors
process_normal = #e5e5e5
process_highlight = #c6c6c6
process_killed = #c0b56b

# Border and separator colors
border = #767676
separator = #484848

# Chart and graph colors
chart_line = #fbf9f5
chart_fill = #1a1a1a

# Status indicators
status_ok = #d0e8b6
status_warning = #f3f2e5
status_error = #c0b56b
status_info = #95c9a8
