# Allowlist: ignore everything, then opt in to configs worth syncing.
/*

!/.gitignore
!/.githooks
!/install.sh
!/bin
!/packages
!/system
!/scripts

# Terminals / tools
!/alacritty
!/neofetch
!/nvim
!/tmux
!/fuzzel
!/cava
!/htop
!/nvtop

# Hyprland / Caelestia. These dirs are real here; ~/.local/share/caelestia/<dir>
# is a symlink back to them (install.sh creates it), so edits are always tracked.
!/hypr
!/fish
!/foot
!/btop
!/uwsm
!/quickshell
!/caelestia

# Desktop / KDE-app settings
!/environment.d
!/mimeapps.list
!/kdeglobals
!/kglobalshortcutsrc
!/dolphinrc
!/katerc
!/konsolerc

# Selected files only (the rest is generated by caelestia or is cache)
!/gtk-3.0
/gtk-3.0/*
!/gtk-3.0/settings.ini
!/gtk-4.0
/gtk-4.0/*
!/gtk-4.0/settings.ini
!/qtengine
/qtengine/*
!/qtengine/config.json
!/fcitx5
/fcitx5/*
!/fcitx5/config
!/fcitx5/profile
!/fcitx5/conf
/fcitx5/conf/*
!/fcitx5/conf/hangul.conf
!/fcitx5/conf/notifications.conf

# NOT tracked here, by design: systemd/user, discord-presence/config.json and
# ~/.gitconfig, ~/.ssh/config live in the PRIVATE repo ~/.config-private
# (they contain emails, domains, hostnames). They show up here only as symlinks
# and stay ignored. Never track: ssh keys, *.pem, credentials.json, secrets.fish.

# Secrets / state / generated inside allowed dirs
fish/secrets.fish
fish/fish_variables
fish/*.bak*
fish/**/*.bak*
hypr/scheme/current.conf
btop/btop.log
btop/themes/
__pycache__/
*.pyc
*.pem
*credentials*.json
.env
