#!/usr/bin/env python3
"""Update hand-entered balances (401(k), HSA, ...) shown in the Investments widget.

It first opens the Gusto 401(k) and Elevate HSA pages (LINKS, or "links" in manual.json) so you can read the balances.
Run it from the widget's update button, or any time. Each balance is asked in a fuzzel prompt that starts
with the current value: press Enter to keep it, type a new balance, or "+500" to add to it.
The prompt runs in a small floating foot window (app-id invest-update, see hypr-user.conf) so the
browser pages stay usable; started without a terminal (e.g. from the widget), it relaunches itself there.
Add or rename rows by editing ~/.local/share/plaid-balance/manual.json (a "label" per account;
an optional "bonus" is added to the typed balance when shown, e.g. 500 for the HSA).
"""
import datetime, json, os, re, readline, subprocess, sys

MANUAL = os.path.expanduser("~/.local/share/plaid-balance/manual.json")
# Opened in the browser first so the current balances are one click away.
# Account-specific URLs go in a "links" list in manual.json, not here.
LINKS = ["https://app.gusto.com", "https://gusto.elevateaccounts.com"]
DEFAULT = {"accounts": [{"label": "401(k)", "institution": "", "value": None},
                        {"label": "HSA", "institution": "", "value": None, "bonus": 500}]}


def ask(label, current, bonus=0):
    """Prompt with the current balance prefilled; None when the prompt is dismissed (Ctrl-D / Ctrl-C)."""
    shown = "" if current is None else f"{current:.2f}"
    readline.set_startup_hook(lambda: readline.insert_text(shown))
    try:
        note = f" (+${bonus:,.0f})" if bonus else ""
        return input(f"{label} balance{note}: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    finally:
        readline.set_startup_hook()


def parse(text, current):
    """'' keeps the value, '+500' adds to it, otherwise a new balance ($ and commas allowed)."""
    t = text.replace("$", "").replace(",", "").replace(" ", "")
    if not t:
        return current
    m = re.fullmatch(r"([+-]?)(\d+(?:\.\d+)?)", t)
    if not m:
        raise ValueError(text)
    n = float(m.group(2))
    if m.group(1):
        return round((current or 0) + (n if m.group(1) == "+" else -n), 2)
    return round(n, 2)


def main():
    if not sys.stdin.isatty():
        subprocess.run(["foot", "--app-id", "invest-update", "--title", "Update balances", sys.executable, os.path.abspath(__file__)])
        return
    os.makedirs(os.path.dirname(MANUAL), exist_ok=True)
    try:
        data = json.load(open(MANUAL))
    except (OSError, ValueError):
        data = DEFAULT
    for url in data.get("links", LINKS):
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for a in data["accounts"]:
        text = ask(a["label"], a.get("value"), a.get("bonus", 0))
        if text is None:  # prompt dismissed: leave this one alone
            continue
        try:
            new = parse(text, a.get("value"))
        except ValueError:
            subprocess.run(["notify-send", "Investments", f"Ignored “{text}” for {a['label']}"])
            continue
        # Enter (unchanged) still counts as confirmed, which clears the widget's "update due" button
        a["value"], a["updated"] = new, datetime.date.today().isoformat()
    tmp = MANUAL + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, MANUAL)
    subprocess.run(["qs", "-c", "plaid-invest", "ipc", "call", "invest", "reload"], capture_output=True)


main()
